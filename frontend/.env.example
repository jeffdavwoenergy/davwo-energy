# Copy to .env.local for local development, and set the same names in Vercel.
# Never commit real values.

# Auth
JWT_SECRET=                      # required in production
# JWT_EXPIRES=12h

# Database (Supabase Postgres via Prisma). Without DATABASE_URL the app runs
# on per-instance in-memory fallbacks (demo only).
DATABASE_URL=                    # pooled connection, port 6543
DIRECT_URL=                      # direct connection, port 5432: migrations only

# Device integrations: 32 bytes, base64 or 64 hex chars. Required in
# production to store device credentials. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATIONS_ENCRYPTION_KEY=

# ANI language model (optional: ANI falls back to deterministic templates)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_REASONING_EFFORT=low     # for reasoning models that accept it

# Scheduled jobs (Vercel Cron sends this as a bearer token)
CRON_SECRET=

# One-click demo sign-in (demo deployments only)
# ALLOW_DEMO_LOGIN=true

# Email (optional)
# RESEND_API_KEY=
# EMAIL_FROM=
